# Copy to .env for local development. Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow

# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-long-random-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
